# Copy to .env.local for local development, and add the same keys in
# Vercel → Project → Settings → Environment Variables for production.

# Public site URL, used for canonical links, sitemap, and social previews.
NEXT_PUBLIC_SITE_URL=https://ereachmarketing.com

# ---- Lead form destination (server-side only, never exposed to browsers) ----
# Set ONE of these. Without either, the form shows a friendly
# "temporarily unavailable, please call" message instead of fake success.

# Formspree form id: the part after https://formspree.io/f/
FORMSPREE_FORM_ID=

# Or any HTTPS webhook (Zapier, Make, HubSpot workflow, your CRM, Slack, etc.)
LEAD_WEBHOOK_URL=

# ---- Optional ----
# Scheduling page (Calendly, Cal.com, HubSpot Meetings...). When set, every
# "Book a free consultation" button opens it. When empty, buttons go to the form.
NEXT_PUBLIC_BOOKING_URL=

# Public review profile (Google, Clutch...). Shows a "Read client reviews" button.
NEXT_PUBLIC_REVIEWS_URL=
